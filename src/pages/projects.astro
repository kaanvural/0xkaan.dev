---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Prompt from '../components/Prompt.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);

// Label for the status badge; colour handled by the .st-* class.
const statusLabel: Record<string, string> = {
  wip: 'wip',
  active: 'active',
  stable: 'stable',
  archived: 'archived',
};

// Strip the protocol so the repo reads like a path in the clone line.
const shortRepo = (url: string) => url.replace(/^https?:\/\//, '');
---
<BaseLayout title="projects">
  <!-- ===== HEADER ===== -->
  <section class="head" aria-labelledby="projects-h">
    <Prompt cmd="ls ~/tools/" cursor={true} />
    <h1 id="projects-h" class="page-h">./projects</h1>
    <p class="lead">Small tools and configs I actually use.</p>
  </section>

  <hr class="hr" />

  <!-- ===== TOOLS ===== -->
  <section aria-labelledby="bin">
    <Prompt cmd={`ls -l ~/tools/ | sort -k2 · ${projects.length} ${projects.length === 1 ? 'entry' : 'entries'}`} />
    <h2 id="bin" class="sec-h">// bin</h2>

    {projects.length === 0 && (
      <p class="empty faint">
        <span class="e-prompt">$</span> ls ~/tools/ · nothing published yet. Tools ship here once they're worth cloning.
      </p>
    )}

    <ol class="tools">
      {projects.map((p) => {
        const perms = p.data.status === 'archived' ? '-rw-r--r--' : '-rwxr-xr-x';
        return (
          <li class="tool" id={p.id}>
            <header class="tool-h">
              <span class="perms faint">{perms}</span>
              <span class="cmd">
                <span class="dollar faint" aria-hidden="true">$</span>
                <span class="name">{p.data.title}</span>
              </span>
              <span class:list={['badge', 'st', `st-${p.data.status}`]}>
                {statusLabel[p.data.status] ?? p.data.status}
              </span>
            </header>

            <div class="tool-b">
              {p.data.sample && (
                <span class="sample faint" title="placeholder, replace with a real tool">
                  # sample
                </span>
              )}
              <p class="tool-s">{p.data.summary}</p>

              <ul class="tags">
                {p.data.tags.map((t) => <li class="tag hash">{t}</li>)}
              </ul>
            </div>

            <footer class="tool-f">
              {p.data.repo ? (
                <a class="clone" href={p.data.repo} rel="noopener">
                  <span class="git faint" aria-hidden="true">git clone</span>
                  <span class="repo">{shortRepo(p.data.repo)}</span>
                  <span class="arr" aria-hidden="true">→</span>
                </a>
              ) : (
                <span class="norepo faint">// no public repo</span>
              )}
            </footer>
          </li>
        );
      })}
    </ol>

    {projects.length > 0 && (
      <p class="foot faint">// each of these earns its place by saving me keystrokes, not stars</p>
    )}
  </section>
</BaseLayout>

<style>
  .head { padding-top: clamp(2rem, 5vw, 3.5rem); }
  .lead { margin-top: .7rem; }

  .sec-h {
    font-family: var(--mono); font-weight: 600; font-size: 1.05rem;
    color: var(--accent); text-shadow: none; letter-spacing: .02em;
  }

  .empty {
    margin-top: 1.1rem; font-size: .85rem; line-height: 1.6;
    padding: .9rem 1rem; border: 1px dashed var(--line); background: var(--bg-1);
  }
  .empty .e-prompt { color: var(--accent-deep); }

  .tools {
    list-style: none; margin: 1.2rem 0 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1rem;
  }

  /* Executable-listing card, kin to the writeup case-file, but reads as a tool. */
  .tool {
    border: 1px solid var(--line);
    background: var(--bg-1);
    display: flex; flex-direction: column;
    /* clipped corner, mirrored from the writeup card */
    clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 0 100%);
    scroll-margin-top: 5rem;
  }
  .tool:hover { border-color: var(--accent-deep); }
  .tool:target {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent-deep);
  }

  .tool-h {
    display: flex; align-items: baseline; gap: .6rem;
    padding: .55rem .8rem; border-bottom: 1px dashed var(--line);
    font-size: .78rem; flex-wrap: wrap;
  }
  .perms { font-size: .72rem; }
  .cmd { display: inline-flex; align-items: baseline; gap: .4ch; min-width: 0; }
  .dollar { font-size: .8rem; }
  .name {
    font-family: var(--mono); font-weight: 600; font-size: .92rem;
    color: var(--accent); word-break: break-word;
  }

  /* status badges, reuse .badge box, colour by state */
  .st { margin-left: auto; }
  .st-wip      { color: var(--accent); border-color: var(--accent-deep); }
  .st-active   { color: var(--done);  border-color: color-mix(in srgb, var(--done) 40%, var(--line)); }
  .st-stable   { color: var(--done);  border-color: color-mix(in srgb, var(--done) 55%, var(--line)); }
  .st-archived { color: var(--ink-faint); border-color: var(--line); }

  .tool-b { padding: .8rem .9rem .6rem; flex: 1; }
  .sample {
    display: inline-block; font-size: .7rem; letter-spacing: .06em;
    margin-bottom: .4rem;
  }
  .tool-s { font-size: .9rem; line-height: 1.6; color: var(--ink); margin: 0 0 .7rem; }

  .tags { list-style: none; display: flex; flex-wrap: wrap; gap: .35rem; margin: 0; padding: 0; }

  .tool-f {
    padding: .55rem .9rem; border-top: 1px dashed var(--line);
    font-size: .78rem;
  }
  .clone {
    display: inline-flex; align-items: baseline; gap: .5ch;
    text-decoration: none; max-width: 100%;
  }
  .clone .git { font-size: .74rem; white-space: nowrap; }
  .clone .repo {
    color: var(--accent); text-decoration: underline;
    text-decoration-color: var(--accent-deep); text-underline-offset: 3px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .clone:hover .repo { text-decoration-color: var(--accent); }
  .clone .arr { color: var(--accent-deep); }
  .clone:hover .arr { color: var(--accent); }
  .norepo { font-size: .76rem; }

  .foot { margin-top: 1.1rem; font-size: .76rem; }
</style>
