---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prompt from '../../components/Prompt.astro';
import Comments from '../../components/Comments.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('writeups', (e) => !e.data.draft))
    .sort((a, b) => +b.data.date - +a.data.date);
  return entries.map((entry, i) => ({
    params: { id: entry.id },
    props: {
      entry,
      prev: entries[i + 1] ?? null, // older
      next: entries[i - 1] ?? null, // newer
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

// filename slug, same convention as the card feed on the homepage
const fileFor = (id: string) => id.replace(/[^a-z0-9]+/gi, '_').toLowerCase();
const slug = `${d.platform.toLowerCase()}_${fileFor(d.box || entry.id)}.md`;

const words = (entry.body || '').split(/\s+/).filter(Boolean).length;
const readMin = Math.max(1, Math.round(words / 200));
const dateStr = d.date.toISOString().slice(0, 10);

// "on this page", h2 only, non-essential
const toc = headings.filter((h) => h.depth === 2);
---
<BaseLayout title={d.title} description={d.summary}>
  <!-- ===== BACK ===== -->
  <nav class="topnav" aria-label="breadcrumb">
    <a class="back" href="/writeups">← ./writeups</a>
  </nav>

  <!-- ===== CASE-FILE HEADER ===== -->
  <section class="hdr" aria-labelledby="wu-title">
    <Prompt cmd={`cat ${slug}`} />
    <h1 id="wu-title" class="page-h">{d.title}</h1>

    <div class="meta">
      <span class:list={['badge', d.platform.toLowerCase()]}>{d.platform}</span>
      {d.os && <span class="badge">{d.os}</span>}
      {d.difficulty && <span class:list={['badge', d.difficulty]}>{d.difficulty}</span>}
      <span class="dot faint" aria-hidden="true">·</span>
      <time class="faint" datetime={dateStr}>{dateStr}</time>
      <span class="dot faint" aria-hidden="true">·</span>
      <span class="faint">~{readMin} min</span>
    </div>

    {d.tags.length > 0 && (
      <ul class="tags">
        {d.tags.map((t) => <li class="tag hash">{t}</li>)}
      </ul>
    )}

    {d.sample && (
      <p class="sample faint">// sample writeup, replace with your own</p>
    )}
  </section>

  <hr class="hr" />

  <!-- ===== ON THIS PAGE ===== -->
  {toc.length >= 3 && (
    <nav class="toc" aria-label="on this page">
      <p class="toc-h faint"># on_this_page</p>
      <ol>
        {toc.map((h) => (
          <li><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ol>
    </nav>
  )}

  <!-- ===== BODY ===== -->
  <div class="md-body">
    <Content />
  </div>

  <Comments />

  <hr class="hr" />

  <!-- ===== PREV / NEXT ===== -->
  <nav class="pager" aria-label="more writeups">
    {prev ? (
      <a class="pg prev" href={`/writeups/${prev.id}`}>
        <span class="pg-dir faint">← older</span>
        <span class="pg-t">{prev.data.title}</span>
      </a>
    ) : <span class="pg-spacer" />}
    {next ? (
      <a class="pg next" href={`/writeups/${next.id}`}>
        <span class="pg-dir faint">newer →</span>
        <span class="pg-t">{next.data.title}</span>
      </a>
    ) : <span class="pg-spacer" />}
  </nav>

  <p class="allback">
    <a href="/writeups">← all writeups</a>
  </p>
</BaseLayout>

<style>
  .topnav { padding-top: clamp(1.5rem, 4vw, 2.5rem); }
  .back { font-size: .84rem; }

  .hdr { padding-top: 1rem; }
  .meta {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: .5rem; margin-top: 1rem; font-size: .82rem;
  }
  .meta time { font-size: .82rem; }
  .dot { font-size: .82rem; }

  .tags {
    list-style: none; display: flex; flex-wrap: wrap;
    gap: .35rem; margin: .9rem 0 0; padding: 0;
  }
  .sample { margin-top: .9rem; font-size: .78rem; }

  .toc {
    border: 1px solid var(--line);
    border-left: 2px solid var(--accent-deep);
    background: var(--bg-1);
    padding: .8rem 1rem;
    margin-bottom: 1.6rem;
    max-width: var(--measure);
    font-size: .86rem;
  }
  .toc-h { font-size: .74rem; letter-spacing: .1em; margin: 0 0 .5rem; }
  .toc ol { margin: 0; padding-left: 1.2rem; display: grid; gap: .25rem; }
  .toc li { color: var(--ink-soft); }
  .toc a { text-decoration-color: var(--accent-deep); }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .pg {
    display: grid; gap: .25rem;
    border: 1px solid var(--line); background: var(--bg-1);
    padding: .8rem .9rem; text-decoration: none;
    /* clipped corner, matching the case-file cards */
    clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 0 100%);
  }
  .pg:hover { border-color: var(--accent-deep); }
  .pg.next { text-align: right; }
  .pg-dir { font-size: .74rem; letter-spacing: .08em; }
  .pg-t {
    font-family: var(--mono); font-weight: 600; font-size: .92rem;
    color: var(--ink); line-height: 1.3;
  }
  .pg:hover .pg-t { color: var(--accent); }
  .pg-spacer { display: block; }

  .allback { margin-top: 1.6rem; font-size: .86rem; }

  @media (max-width: 560px) {
    .pager { grid-template-columns: 1fr; }
    .pg.next { text-align: left; }
  }
</style>
