---
import IosLayout from '../../layouts/IosLayout.astro';
import { iosSite } from '../../data/site';
---
<IosLayout>
  <!-- ===== HERO ===== -->
  <section class="ihero">
    <p class="eyebrow">{iosSite.role}</p>
    <h1 class="ihero-h">{iosSite.name}</h1>
    <p class="ihero-lead">{iosSite.tagline}</p>

    <div class="ihero-bio">
      {iosSite.bio.map((p) => <p>{p}</p>)}
    </div>
  </section>
</IosLayout>

<style>
  .ihero { padding-top: clamp(2rem, 6vw, 4.5rem); max-width: 46rem; }
  .eyebrow {
    font-size: .8rem; letter-spacing: .14em; text-transform: uppercase;
    color: var(--accent); margin: 0 0 1rem; font-weight: 600;
  }
  .ihero-h { margin: 0; }
  .ihero-lead {
    font-family: var(--serif); font-size: clamp(1.3rem, 3vw, 1.7rem);
    color: var(--ink-soft); font-style: italic; margin: 1rem 0 0; line-height: 1.3;
  }
  .ihero-bio { margin-top: 1.8rem; max-width: 40rem; }
  .ihero-bio p { margin: .9rem 0; color: var(--ink-soft); font-size: 1.05rem; }
</style>
