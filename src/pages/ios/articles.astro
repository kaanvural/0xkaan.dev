---
import { getCollection } from 'astro:content';
import IosLayout from '../../layouts/IosLayout.astro';

const readMin = (body = '') => Math.max(1, Math.round(body.split(/\s+/).length / 200));

const articles = [...(await getCollection('iosArticles', (e) => !e.data.draft))]
  .sort((a, b) => +b.data.date - +a.data.date)
  .map((e) => ({
    id: e.id,
    href: `/ios/articles/${e.id}`,
    date: e.data.date.toISOString().slice(0, 10),
    title: e.data.title,
    tags: e.data.tags,
    summary: e.data.summary,
    readMin: readMin(e.body),
    sample: e.data.sample,
  }));

const total = articles.length;
const tagSet = new Set(articles.flatMap((n) => n.tags));
---
<IosLayout title="Articles">
  <!-- ===== HEADER ===== -->
  <section aria-labelledby="articles-h">
    <h1 id="articles-h" class="page-h">Articles</h1>
    <p class="lead">Writing on Swift, SwiftUI and shipping iOS apps.</p>
    <p class="meta faint">
      {total} {total === 1 ? 'article' : 'articles'}
      {tagSet.size > 0 && <> · {tagSet.size} tags · newest first</>}
    </p>
  </section>

  <hr class="hr" />

  <!-- ===== INDEX ===== -->
  <section aria-labelledby="index-h">
    <h2 id="index-h" class="sec-h">Writing</h2>

    {total === 0 ? (
      <div class="empty">
        <p class="muted">
          Nothing published yet. Articles will appear here as soon as the first
          one lands.
        </p>
      </div>
    ) : (
      <ol class="articles">
        {articles.map((n) => (
          <li class:list={['article', { sample: n.sample }]}>
            <a class="row-link" href={n.href} aria-label={`Read article: ${n.title}`}></a>
            <div class="row-head">
              {n.sample && <span class="sample-mark faint" title="placeholder, replace with a real article">sample</span>}
              <span class="date faint">{n.date}</span>
              <span class="read faint">~{n.readMin} min read</span>
            </div>
            <h3 class="row-title">{n.title}</h3>
            <p class="row-summary">{n.summary}</p>
            {n.tags.length > 0 && (
              <ul class="tags" aria-label="tags">
                {n.tags.map((t) => <li class="tag">{t}</li>)}
              </ul>
            )}
          </li>
        ))}
      </ol>
    )}
    <p class="foot faint">{total > 0 ? 'Select an article to read the full piece.' : 'Check back soon.'}</p>
  </section>
</IosLayout>

<style>
  .meta { font-size: .78rem; margin-top: .7rem; letter-spacing: .02em; }

  .sec-h {
    font-family: var(--mono); font-weight: 600; font-size: 1.05rem;
    color: var(--accent); text-shadow: none; letter-spacing: .02em;
  }

  /* ---- article list: dense rows, dashed separators ---- */
  .articles { list-style: none; margin: 1.1rem 0 0; padding: 0; }
  .article {
    position: relative;
    padding: 1rem .2rem 1.1rem;
    border-top: 1px dashed var(--line);
    transition: background .12s, border-color .12s;
  }
  .article:last-child { border-bottom: 1px dashed var(--line); }
  .article:hover { background: var(--bg-1); }

  /* full-row click target sits under the text; real links stay reachable */
  .row-link {
    position: absolute; inset: 0; z-index: 1;
    text-decoration: none;
  }
  .row-link:focus-visible {
    outline: 2px solid var(--accent); outline-offset: -2px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .row-head {
    display: flex; align-items: baseline; gap: .6rem;
    font-size: .78rem; flex-wrap: wrap;
  }
  .sample-mark {
    font-size: .64rem; letter-spacing: .12em; text-transform: uppercase;
    border: 1px solid var(--line); border-radius: 2px; padding: .02em .4em;
  }
  .date { margin-left: auto; font-size: .74rem; }
  .read { font-size: .74rem; }

  .row-title {
    font-family: var(--mono); font-weight: 600; font-size: 1.06rem;
    line-height: 1.3; color: var(--ink); text-shadow: none;
    margin: .5rem 0 .4rem; max-width: var(--measure);
  }
  .article:hover .row-title { color: var(--accent); }
  .row-summary {
    color: var(--ink-soft); font-size: .9rem; line-height: 1.6;
    margin: 0 0 .6rem; max-width: var(--measure);
  }

  .tags {
    position: relative; z-index: 2; width: fit-content;
    list-style: none; display: flex; flex-wrap: wrap; gap: .35rem;
    margin: 0; padding: 0;
  }

  /* ---- empty state ---- */
  .empty { margin-top: 1.2rem; }
  .empty p { max-width: var(--measure); }

  .foot { margin-top: 1.4rem; font-size: .76rem; }

  @media (max-width: 560px) {
    .date { margin-left: 0; }
  }
</style>
