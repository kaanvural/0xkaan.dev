---
import IosLayout from '../../layouts/IosLayout.astro';
import { iosSite } from '../../data/site';
---
<IosLayout title="Resume" description={`Resume of ${iosSite.name}, ${iosSite.role}.`}>
  <section class="resume">
    <h1 class="page-h">{iosSite.name}</h1>

    <p class="lead">Full resume coming soon.</p>
    <p class="note">
      In the meantime, you can reach me through the links on the
      <a href="/ios">home page</a>.
    </p>

    <!-- Wire a real file here when it's ready:
         <a class="dl" href="/kaan-vural-resume.pdf" download>Download PDF</a> -->
  </section>
</IosLayout>

<style>
  .resume { padding-top: clamp(2rem, 6vw, 4.5rem); max-width: 46rem; }
  .lead { margin-top: 1.4rem; font-size: 1.1rem; color: var(--ink); }
  .note { margin-top: .6rem; color: var(--ink-soft); }
</style>
