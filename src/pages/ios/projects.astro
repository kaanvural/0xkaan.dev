---
import { getCollection } from 'astro:content';
import IosLayout from '../../layouts/IosLayout.astro';

const projects = (await getCollection('iosProjects')).sort(
  (a, b) => a.data.order - b.data.order,
);

// Label for the status badge; colour handled by the .st-* class.
const statusLabel: Record<string, string> = {
  live: 'live',
  shipped: 'shipped',
  wip: 'in progress',
  archived: 'archived',
};
---
<IosLayout title="Projects">
  <!-- ===== HEADER ===== -->
  <section class="head" aria-labelledby="projects-h">
    <h1 id="projects-h" class="page-h">Projects</h1>
    <p class="lead">Apps I have designed, built and shipped.</p>
  </section>

  <hr class="hr" />

  <!-- ===== APPS ===== -->
  <section aria-labelledby="apps">
    <div class="sec-head">
      <h2 id="apps" class="sec-h">Selected work</h2>
      <span class="count faint">{projects.length} {projects.length === 1 ? 'app' : 'apps'}</span>
    </div>

    {projects.length === 0 && (
      <p class="empty faint">
        Nothing published yet. Apps land here once they are live in the App Store.
      </p>
    )}

    <ol class="apps">
      {projects.map((p) => (
        <li class="app" id={p.id}>
          <header class="app-h">
            <h3 class="name">{p.data.title}</h3>
            <span class:list={['badge', 'st', `st-${p.data.status}`]}>
              {statusLabel[p.data.status] ?? p.data.status}
            </span>
          </header>

          <div class="app-b">
            {(p.data.role || p.data.year) && (
              <p class="meta faint">
                {p.data.role}{p.data.role && p.data.year ? ' · ' : ''}{p.data.year}
              </p>
            )}
            {p.data.sample && (
              <span class="sample faint" title="placeholder, replace with a real app">
                sample
              </span>
            )}
            <p class="app-s">{p.data.summary}</p>

            {p.data.tags.length > 0 && (
              <ul class="tags">
                {p.data.tags.map((t) => <li class="tag hash">{t}</li>)}
              </ul>
            )}
          </div>

          {(p.data.appStore || p.data.repo) && (
            <footer class="app-f">
              {p.data.appStore && (
                <a class="link" href={p.data.appStore} rel="noopener">
                  App Store <span class="arr" aria-hidden="true">→</span>
                </a>
              )}
              {p.data.repo && (
                <a class="link" href={p.data.repo} rel="noopener">
                  Source <span class="arr" aria-hidden="true">→</span>
                </a>
              )}
            </footer>
          )}
        </li>
      ))}
    </ol>
  </section>
</IosLayout>

<style>
  .lead { margin-top: .7rem; }

  .sec-head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 1rem; flex-wrap: wrap; margin-top: 1.6rem;
  }
  .sec-h {
    font-family: var(--mono); font-weight: 600; font-size: 1.05rem;
    color: var(--accent); text-shadow: none; letter-spacing: .02em; margin: 0;
  }
  .count { font-size: .8rem; }

  .empty {
    margin-top: 1.1rem; font-size: .9rem; line-height: 1.6;
    padding: .9rem 1rem; border: 1px dashed var(--line); background: var(--bg-1);
    border-radius: 6px;
  }

  .apps {
    list-style: none; margin: 1.2rem 0 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1rem;
  }

  .app {
    border: 1px solid var(--line);
    background: var(--panel);
    border-radius: 10px;
    display: flex; flex-direction: column;
    scroll-margin-top: 5rem;
    transition: border-color .15s, transform .15s;
  }
  .app:hover { border-color: var(--accent-dim); transform: translateY(-2px); }
  .app:target { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent-dim); }

  .app-h {
    display: flex; align-items: baseline; gap: .6rem; flex-wrap: wrap;
    padding: .9rem 1rem .5rem;
  }
  .name {
    font-family: var(--mono); font-weight: 600; font-size: 1.15rem;
    color: var(--ink); word-break: break-word; margin: 0;
  }

  /* status badges, reuse .badge box, colour by state */
  .st { margin-left: auto; }
  .st-live     { color: var(--done);      border-color: color-mix(in srgb, var(--done) 55%, var(--line)); }
  .st-shipped  { color: var(--accent);    border-color: var(--accent-deep); }
  .st-wip      { color: var(--ink-soft);  border-color: var(--line); }
  .st-archived { color: var(--ink-faint); border-color: var(--line); }

  .app-b { padding: 0 1rem .7rem; flex: 1; }
  .meta { font-size: .78rem; margin: 0 0 .5rem; }
  .sample {
    display: inline-block; font-size: .7rem; letter-spacing: .06em;
    margin-bottom: .4rem; text-transform: uppercase;
  }
  .app-s { font-size: .95rem; line-height: 1.6; color: var(--ink-soft); margin: 0 0 .8rem; }

  .tags { list-style: none; display: flex; flex-wrap: wrap; gap: .35rem; margin: 0; padding: 0; }

  .app-f {
    padding: .6rem 1rem; border-top: 1px solid var(--line);
    display: flex; flex-wrap: wrap; gap: 1.1rem; font-size: .85rem;
  }
  .link { font-weight: 500; }
  .link .arr { color: var(--accent-dim); }
  .link:hover .arr { color: var(--accent); }
</style>
