---
// One 404 for the whole site. Vercel serves this /404.html for every unknown
// path, so it detects whether the request was under /ios and re-skins itself to
// the beige iOS world; otherwise it stays in the dark security world.
import '../styles/global.css';
import '../styles/ios.css';
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- pick the world before paint, so there is no theme flash -->
    <script is:inline>
      try {
        var p = (location.pathname || '/').replace(/\/+$/, '');
        if (p === '/ios' || p.indexOf('/ios/') === 0) {
          document.documentElement.setAttribute('data-world', 'ios');
        }
      } catch (e) {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=VT323&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="wrap e404">
      <a class="e-brand" href="/" id="home-link" aria-label="home">
        <span class="brand-emoji" aria-hidden="true">👾</span>
      </a>

      <p class="errline" id="errline" role="alert">
        <span class="sh">bash:</span>
        <span class="path" id="req-path">/that/page</span><span class="sep">:</span>
        No such file or directory
      </p>

      <p class="glitch" aria-hidden="true">404</p>
      <h1 class="visually-hidden">404, page not found</h1>

      <p class="human" id="human">
        This box doesn't exist, or you don't have the creds.
        <span class="faint">Either way, you're back at the door.</span>
      </p>

      <nav class="exits" aria-label="ways back">
        <ul id="exits">
          <li><a href="/" data-home>back home</a></li>
        </ul>
      </nav>
    </div>

    <script is:inline>
      (function () {
        try {
          var p = (location.pathname || '/').replace(/\/+$/, '');
          var isIos = p === '/ios' || p.indexOf('/ios/') === 0;

          var reqEl = document.getElementById('req-path');
          if (reqEl) {
            var clean = p.slice(0, 80).replace(/[^\w\-./~]/g, '');
            if (clean && clean !== '/') reqEl.textContent = clean;
          }

          var homeLink = document.getElementById('home-link');
          var human = document.getElementById('human');
          var exits = document.getElementById('exits');

          if (isIos) {
            if (homeLink) homeLink.setAttribute('href', '/ios');
            var errline = document.getElementById('errline');
            if (errline) {
              errline.innerHTML = 'Page not found: <span class="path"></span>';
              errline.querySelector('.path').textContent = (reqEl && reqEl.textContent) || p;
            }
            if (human) human.firstChild.textContent = "That page isn't here. ";
            if (exits) exits.innerHTML =
              '<li><a href="/ios">iOS home</a></li>' +
              '<li><a href="/ios/articles">articles</a></li>' +
              '<li><a href="/ios/projects">projects</a></li>';
          } else {
            if (exits) exits.innerHTML =
              '<li><a href="/">home</a></li>' +
              '<li><a href="/writeups">writeups</a></li>' +
              '<li><a href="/notes">notes</a></li>';
          }
        } catch (e) {}
      })();
    </script>

    <style>
      .e404 { padding-top: clamp(2.5rem, 8vw, 5rem); max-width: var(--measure); }
      .e-brand { display: inline-flex; text-decoration: none; margin-bottom: 1.6rem; }
      .brand-emoji {
        font-size: 2rem; line-height: 1;
        color: transparent; text-shadow: 0 0 0 var(--accent);
      }
      :root[data-world='ios'] .brand-emoji { color: var(--ink); text-shadow: none; }

      .errline { font-size: .92rem; color: var(--ink); margin: 0 0 1.4rem; word-break: break-word; line-height: 1.6; }
      .errline .sh { color: var(--red); }
      .errline .path { color: var(--accent-dim); }
      .errline .sep { color: var(--ink-faint); }

      .glitch {
        font-family: var(--display);
        font-size: clamp(4.5rem, 24vw, 10rem);
        line-height: .9; letter-spacing: .04em;
        color: var(--accent); text-shadow: var(--glow);
        margin: 0; display: inline-block;
      }
      :root[data-world='ios'] .glitch {
        font-family: var(--mono); font-weight: 600; text-shadow: none;
      }

      .human { color: var(--ink); font-size: 1.02rem; margin: .8rem 0 1.4rem; line-height: 1.7; }
      .human .faint { display: inline; }

      .exits ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 1.2rem; }
      .exits a { font-size: 1rem; }
    </style>
  </body>
</html>
